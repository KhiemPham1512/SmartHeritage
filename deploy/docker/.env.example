# Sao chép thành .env rồi điền. KHÔNG commit file .env.

# Mật khẩu tài khoản sa của SQL Server: >= 8 ký tự, có chữ hoa, chữ thường, số và ký hiệu (SQL Server bắt buộc)
DB_PASSWORD=ChangeMe_Str0ng!Pass

# Khóa ký đăng nhập, >= 32 ký tự ngẫu nhiên. Tạo bằng:  openssl rand -hex 32   (hoặc PowerShell: -join ((1..64) | % { '{0:x}' -f (Get-Random -Max 16) }))
JWT_SECRET=

# Cổng publish ra ngoài (mặc định 8000). Khi dùng HTTPS qua Caddy: API_BIND=127.0.0.1 để chỉ Caddy truy cập được.
HTTP_PORT=8000
API_BIND=0.0.0.0

# Chỉ cần khi web admin chạy ở tên miền KHÁC với API (mặc định cùng gốc nên để trống)
CORS_ORIGINS=

# Dùng với:  docker compose --profile https up -d --build
DOMAIN=
